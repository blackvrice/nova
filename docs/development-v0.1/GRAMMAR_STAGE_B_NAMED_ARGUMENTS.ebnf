(* P17 named function arguments: Accepted by user on 2026-10-07; implemented and verified.
   Extends accepted P16: arguments changes; argument added (52 total).
   User function mapping and source-order evaluation follow NAMED_ARGUMENTS_STAGE_B_PROPOSAL.md. *)
program = { "END" | import_decl | [ visibility ], ( function_decl | global_const_decl | struct_decl | enum_decl ) }, "EOF" ;
import_decl = "use", qualified_name, [ "as", "IDENT" ], end ;
qualified_name = "IDENT", { "::", "IDENT" } ;
visibility = "public" | "internal" | "private" ;
global_const_decl = "const", "IDENT", [ ":", type ], "=", expression, end ;
function_decl = "func", "IDENT", "(", [ parameters ], ")", [ "->", type ], block ;
parameters = parameter, { ",", parameter }, [ "," ] ;
parameter = "IDENT", ":", type ;
type = type_atom, { "?" } ;
block = "{", { "END" | statement }, "}" ;
statement = if_stmt | while_stmt | match_stmt | simple_statement ;
simple_statement = ( binding | assignment | return_stmt | break_stmt | continue_stmt | expression ), end ;
binding = ( "let" | "var" | "const" ), "IDENT", [ ":", type ], "=", expression ;
assignment = field_path, "=", expression ;
return_stmt = "return", [ expression ] ;
break_stmt = "break" ;
continue_stmt = "continue" ;
if_stmt = "if", expression, block, [ "else", ( if_stmt | block ) ] ;
while_stmt = "while", expression, block ;
expression = or_expr ;
or_expr = and_expr, { "||", and_expr } ;
and_expr = compare_expr, { "&&", compare_expr } ;
compare_expr = add_expr, [ compare_op, add_expr ] ;
compare_op = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
add_expr = mul_expr, { ( "+" | "-" ), mul_expr } ;
mul_expr = prefix_expr, { ( "*" | "/" | "%" ), prefix_expr } ;
prefix_expr = ( "+" | "-" | "!" | "try" ), prefix_expr | postfix_expr ;
postfix_expr = primary_expr, { "(", [ arguments ], ")" | "as", type | ".", ( "IDENT" | tuple_index ) } ;
arguments = argument, { ",", argument }, [ "," ] ;
argument = [ "IDENT", ":" ], expression ;
primary_expr = "INT" | "FLOAT" | "CHAR" | "STRING" | "true" | "false" | "IDENT"
             | "(", ")" | "(", expression, ")" | tuple_expr | variant_path | "none" | interpolated_string ;
interpolated_string = "STRING_START", { "STRING_TEXT" | interpolation }, "STRING_END" ;
interpolation = "INTERP_START", expression, "INTERP_END" ;
end = "END" | boundary ;
boundary = ? zero-width only immediately before closing brace or EOF ? ;
struct_decl = "struct", "IDENT", "{", { "END" | field_decl }, "}" ;
field_decl = [ visibility ], ( "let" | "var" ), "IDENT", ":", type, end ;
field_path = "IDENT", { ".", ( "IDENT" | tuple_index ) } ;
tuple_type = "(", type, ",", [ type, { ",", type }, [ "," ] ], ")" ;
tuple_expr = "(", expression, ",", [ expression, { ",", expression }, [ "," ] ], ")" ;
tuple_index = ? canonical ASCII decimal 0 or [1-9][0-9]*, selector-context decimal FLOAT splits into two indexes and Dot using original byte subspans ? ;

enum_decl = "enum", "IDENT", "{", { "END" | variant_decl }, "}" ;
variant_decl = "IDENT", [ "(", payload_types, ")" ], end ;
payload_types = type, { ",", type }, [ "," ] ;
variant_path = "IDENT", "::", "IDENT" ;
match_stmt = "match", expression, "{", { "END" | match_arm }, "}" ;
match_arm = pattern, "=>", block, ( end | "," ) ;
pattern = variant_path, [ "(", pattern_arguments, ")" ] | "true" | "false" | "none" | "_" ;
pattern_arguments = "IDENT", { ",", "IDENT" }, [ "," ] ;

type_atom = "IDENT", [ type_arguments ] | "(", ")" | tuple_type ;
type_arguments = "<", type, { ",", type }, [ "," ], type_close ;
type_close = ? consumes source > and >= token splits only in type argument context preserving one-byte > and = subspans ? ;
