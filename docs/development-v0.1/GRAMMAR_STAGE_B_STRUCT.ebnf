(* P12 Copy struct subset: Accepted by user 2026-10-05; implemented P12 subset.
   Extends accepted P11: program/assignment/postfix_expr plus three productions.
   Constructor calls use existing syntax; field types require semantic validation.
   No new END rules, methods, init/drop, Move fields, or public ABI. *)
program = { "END" | import_decl | [ visibility ], ( function_decl | global_const_decl | struct_decl ) }, "EOF" ;
import_decl = "use", qualified_name, [ "as", "IDENT" ], end ;
qualified_name = "IDENT", { "::", "IDENT" } ;
visibility = "public" | "internal" | "private" ;
global_const_decl = "const", "IDENT", [ ":", type ], "=", expression, end ;
function_decl = "func", "IDENT", "(", [ parameters ], ")", [ "->", type ], block ;
parameters = parameter, { ",", parameter }, [ "," ] ;
parameter = "IDENT", ":", type ;
type = "IDENT" | "(", ")" ;
block = "{", { "END" | statement }, "}" ;
statement = if_stmt | while_stmt | simple_statement ;
simple_statement = ( binding | assignment | return_stmt | break_stmt | continue_stmt | expression ), end ;
binding = ( "let" | "var" | "const" ), "IDENT", [ ":", type ], "=", expression ;
assignment = field_path, "=", expression ;
return_stmt = "return", [ expression ] ;
break_stmt = "break" ;
continue_stmt = "continue" ;
if_stmt = "if", expression, block, [ "else", ( if_stmt | block ) ] ;
while_stmt = "while", expression, block ;
expression = or_expr ;
or_expr = and_expr, { "||", and_expr } ;
and_expr = compare_expr, { "&&", compare_expr } ;
compare_expr = add_expr, [ compare_op, add_expr ] ;
compare_op = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
add_expr = mul_expr, { ( "+" | "-" ), mul_expr } ;
mul_expr = prefix_expr, { ( "*" | "/" | "%" ), prefix_expr } ;
prefix_expr = ( "+" | "-" | "!" ), prefix_expr | postfix_expr ;
postfix_expr = primary_expr, { "(", [ arguments ], ")" | "as", type | ".", "IDENT" } ;
arguments = expression, { ",", expression }, [ "," ] ;
primary_expr = "INT" | "FLOAT" | "CHAR" | "STRING" | "true" | "false" | "IDENT"
             | "(", ")" | "(", expression, ")" | interpolated_string ;
interpolated_string = "STRING_START", { "STRING_TEXT" | interpolation }, "STRING_END" ;
interpolation = "INTERP_START", expression, "INTERP_END" ;
end = "END" | boundary ;
boundary = ? zero-width only immediately before closing brace or EOF ? ;
struct_decl = "struct", "IDENT", "{", { "END" | field_decl }, "}" ;
field_decl = [ visibility ], ( "let" | "var" ), "IDENT", ":", type, end ;
field_path = "IDENT", { ".", "IDENT" } ;
