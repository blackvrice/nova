use values::Event
use values::source
func gate(label:string,result:bool)->bool{print(label);return result}
func propagate(r:Result<int8,int8>)->Result<int8,int8>{match -7 as int8{-7 if (try r)>0=>{print("try-ok")},_=>{print("try-miss")}}return Result::Success(1)}
func main(){
    match source(){
        Event::Data((7,_))=>{print("wrong")},
        Event::Data((-7,'🙂')) if gate("first",false)=>{print("wrong")},
        Event::Data((-0x7,'🙂')) if gate("second",true)=>{print("nested")},
        _=>{print("wrong")}
    }
    match 255 as uint8{0xff=>{print("hex=255")},_=>{}}
    match 0 as int8{-0=>{print("zero")},_=>{}}
    match Option::Some((0b101,true)){Option::Some((0o5,flag))=>{print("option={flag}")},_=>{}}
    match propagate(Result::Success(3)){Result::Success(n)=>{print("result={n}")},Result::Error(e)=>{print("error={e}")}}
    match propagate(Result::Error(4)){Result::Success(_)=>{print("wrong")},Result::Error(e)=>{print("error={e}")}}
    for i in 0 until 3{match i{0=>{continue},2=>{break},n=>{print("loop={n}")}}}
}
