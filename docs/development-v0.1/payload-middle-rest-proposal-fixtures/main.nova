use values::Data
use values::Event
use values::Single
use values::Holder
use values::source
use values::default_value
enum Mutable{Value(int8,char,bool)}
func gate(label:string,result:bool)->bool{print(label);return result}
func mark()->bool{print("omitted");return true}
func binding()->Data{print("initializer");return Single::Value(3,mark(),'가')}
func propagate(r:Result<int8,int8>)->Result<int8,int8>{match Event::Data(-7,true,'가'){Event::Data(-7,..,'가') if (try r)>0=>{print("try-ok")},_=>{}}return Result::Success(1)}
func complete(p:Mutable)->int8{match p{Mutable::Value(..,false)=>{return 2},Mutable::Value(..,true)=>{return 3}}}
func main(){
    match source(){Event::Data(-7,..,'🙂') if gate("first",false)=>{},Event::Data(n,..,ch) if gate("second",true)=>{print("nested={n}")},_=>{}}
    let Single::Value(n,..,character):Data=binding();print("let={n}")
    var Mutable::Value(a,..,b)=Mutable::Value(4 as int8,'가',false);a=a+1;b=true;print("var={a}/{b}")
    const Single::Value(c,..,last):Data=Single::Value(9,true,'가');print("const={c}/{default_value()}")
    match Option::Some(1){Option::Some(..,v)=>{print("one")},none=>{}}
    match Event::Data(1,true,'가'){Event::Data(..,)=>{print("rest-only")},Event::End=>{}}
    let full=complete(Mutable::Value(2,'가',true));print("complete={full}")
    match Holder(Event::Data(5,true,'가'),7){Holder(payload:Event::Data(v,..,'가'),..)=>{print("struct={v}")},_=>{}}
    match Option::Some(Event::Data(6,true,'🙂')){Option::Some(..,Event::Data(v,..,'🙂'))=>{print("option={v}")},_=>{}}
    match propagate(Result::Success(3)){Result::Success(..,v)=>{print("result={v}")},Result::Error(..)=>{}}
    match propagate(Result::Error(4)){Result::Success(..)=>{},Result::Error(..,e)=>{print("error={e}")}}
    for i in 0 until 3{match Mutable::Value(i as int8,'가',true){Mutable::Value(0,..,true)=>{continue},Mutable::Value(2,..,true)=>{break},Mutable::Value(v,..)=>{print("loop={v}")}}}
}
