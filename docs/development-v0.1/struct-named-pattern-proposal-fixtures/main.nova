use values::Pair as P
use values::Envelope
use values::Empty
use values::source
use values::default_value
func gate(label:string,result:bool)->bool{print(label);return result}
func binding()->P{print("initializer");return P(3,true)}
func propagate(r:Result<int8,int8>)->Result<int8,int8>{match P(-7,true){P(flag:true,n:-7) if (try r)>0=>{print("try-ok")},_=>{}}return Result::Success(1)}
func complete(p:P)->int8{match p{P(flag:false,n:n)=>{return n},P(n,flag:true)=>{return n+1}}}
func main(){
    match source(){Envelope(ch:'🙂',pair:P(flag:true,n:-7)) if gate("first",false)=>{},Envelope(pair:P(n,flag:true),ch:ch) if gate("second",true)=>{print("nested={n}/{ch}")},_=>{print("wrong")}}
    let Envelope(ch:ch,pair:P(flag:flag,n:n))=Envelope(binding(),'가')
    print("let={n}/{flag}/{ch}")
    var P(flag:b,n:a)=P(4,false)
    a=a+1;b=true
    print("var={a}/{b}")
    const P(flag:ok,n:c)=P(9,true)
    print("const={c}/{ok}/{default_value()}")
    let Empty()=Empty()
    match Empty(){Empty()=>{print("empty")}}
    let full=complete(P(2,true));print("complete={full}")
    match Option::Some(P(5,true)){Option::Some(P(flag:true,n:v))=>{print("option={v}")},_=>{}}
    match propagate(Result::Success(3)){Result::Success(v)=>{print("result={v}")},Result::Error(_)=>{}}
    match propagate(Result::Error(4)){Result::Success(_)=>{},Result::Error(e)=>{print("error={e}")}}
    for i in 0 until 3{match P(i as int8,true){P(flag:_,n:0)=>{continue},P(2,flag:_)=>{break},P(flag:_,n:v)=>{print("loop={v}")}}}
}
