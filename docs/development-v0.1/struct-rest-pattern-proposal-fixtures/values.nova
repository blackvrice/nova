public struct Pair{public let skip:char;public let n:int8;public let flag:bool}
public struct Envelope{public let pair:Pair;public let ch:char}
public struct Empty{}
public struct Hidden{private let n:int8}
public func hidden()->Hidden{return Hidden(1)}
public const Pair(flag:FLAG,n:NUMBER,..)=Pair('가',-7,true)
public func source()->Envelope{print("scrutinee");return Envelope(Pair('가',NUMBER,FLAG),'🙂')}
public func default_value(n:int8=NUMBER)->int8{return n}
