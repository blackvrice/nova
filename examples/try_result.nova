// P16 Copy try: Success extraction and Error early return.
public enum Failure { Bad(int8); }
public func leaf(flag:bool)->Result<int8,Failure> {
    print("leaf")
    if flag { return Result::Success(7) } else { return Result::Error(Failure::Bad(-1)) }
}
public func second()->int8 { print("second"); return 1 }
public func nested(flag:bool)->Result<Result<int8,Failure>,Failure> {
    let inner:Result<int8,Failure>=leaf(flag)
    return Result::Success(inner)
}
public func ping()->Result<(),Failure> { print("ping"); return Result::Success(()) }
public func truth()->Result<bool,Failure> { print("truth"); return Result::Error(Failure::Bad(-2)) }
func combine(a:int8,b:int8)->int8 { return a+b }
func pipeline(flag:bool)->Result<int16,Failure> {
    print("start")
    let n:int16=combine(try leaf(flag),second())
    print("after")
    return Result::Success(n)
}
func nestedPipeline(flag:bool)->Result<int8,Failure> {
    let n=try try nested(flag)
    return Result::Success(n)
}
func unitPipeline()->Result<(),Failure> { try ping(); return Result::Success(()) }
func snapshot(v:Result<int8,Failure>)->Result<int8,Failure> {
    var current=v
    let x=try current
    current=Result::Error(Failure::Bad(-5))
    return Result::Success(x)
}
func shortCircuit()->Result<bool,Failure> {
    let b=false && try truth()
    return Result::Success(b)
}
func inLoop()->Result<int8,Failure> {
    var n:int8=0
    while n<2 {
        n=n+1
        let x=try leaf(true)
        if n==1 { continue }
        return Result::Success(x)
    }
    return Result::Success(0)
}
func main() {
    match pipeline(true) { Result::Success(n)=>{ print("ok={n}") },Result::Error(_)=>{} }
    match pipeline(false) { Result::Success(_)=>{},Result::Error(e)=>{ match e { Failure::Bad(n)=>{ print("error={n}") } } } }
    match nestedPipeline(true) { Result::Success(n)=>{ print("nested={n}") },Result::Error(_)=>{} }
    match nestedPipeline(false) { Result::Success(_)=>{},Result::Error(e)=>{ match e { Failure::Bad(n)=>{ print("nested-error={n}") } } } }
    match unitPipeline() { Result::Success(_)=>{ print("unit=success") },Result::Error(_)=>{} }
    let original:Result<int8,Failure>=Result::Success(9)
    match snapshot(original) { Result::Success(n)=>{ print("snapshot={n}") },Result::Error(_)=>{} }
    match shortCircuit() { Result::Success(b)=>{ print("short={b}") },Result::Error(_)=>{} }
    match inLoop() { Result::Success(n)=>{ print("loop={n}") },Result::Error(_)=>{} }
}
